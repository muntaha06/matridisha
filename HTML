        },
        "প্রতিদিনের_ব্যায়াম": [
          { "ব্যায়ামের_নাম": "হালকা হাঁটা", "ছবি": "🚶‍♀️", "সময়": "১৫-২০ মিনিট", "বিস্তারিত_কারণ": [ "শরীর সক্রিয়", "প্রসব প্রস্তুতি" ] },
          { "ব্যায়ামের_নাম": "শ্বাস-প্রশ্বাস নিয়ন্ত্রণ", "ছবি": "🌬️", "সময়": "১০ মিনিট", "বিস্তারিত_কারণ": [ "প্রসব সহায়ক", "মানসিক চাপ কমায়" ] }
        ]
      }
    ]
  };

  let currentTrimester = '1-3';
  let currentDetailType = 'food';

  function getTrimesterIndex(trim) {
    if (trim === '1-3') return 0;
    if (trim === '4-6') return 1;
    return 2;
  }

  // পৃষ্ঠা ২ আপডেট
  function updatePage2() {
    const idx = getTrimesterIndex(currentTrimester);
    const data = trimesterData.ত্রৈমাসিক_তথ্য[idx];
    let monthTxt = '', triFull = '';
    if (currentTrimester === '1-3') { monthTxt = '১-৩ মাস'; triFull = 'প্রথম ট্রাইমেস্টার'; }
    else if (currentTrimester === '4-6') { monthTxt = '৪-৬ মাস'; triFull = 'দ্বিতীয় ট্রাইমেস্টার'; }
    else { monthTxt = '৭-৯ মাস'; triFull = 'তৃতীয় ট্রাইমেস্টার'; }

    document.getElementById('page2Header').innerText = triFull;
    document.getElementById('displayMonth').innerText = monthTxt;
    document.getElementById('displayTrimester').innerText = triFull;
    document.getElementById('timePeriod').innerText = data.সময়কাল || '';
    document.getElementById('specialImportance').innerText = data.বিশেষ_গুরুত্ব || '';
  }

  // পৃষ্ঠা ৩ – বিস্তারিত ও ছবি রেন্ডার (সম্পূর্ণ ডাটা সহ)
  function renderDetailPage(type) {
    const idx = getTrimesterIndex(currentTrimester);
    const data = trimesterData.ত্রৈমাসিক_তথ্য[idx];
    const container = document.getElementById('detailContainer');
    let html = '';
    const page3Title = document.getElementById('page3Title');

    if (type === 'food') {
      page3Title.innerText = '🍽️ খাবার তালিকা';
      const kh = data.খাদ্য_তালিকা;
      
      if (kh.শর্করা) {
        html += '<h2>🍚 শর্করা</h2>';
        kh.শর্করা.forEach(item => {
          html += `<div class="item-card"><div class="item-img">${item.ছবি || '🍞'}</div><div class="item-content"><strong>${item.নাম}</strong><ul>${item.বিস্তারিত_কারণ.map(r => `<li>${r}</li>`).join('')}</ul></div></div>`;
        });
      }
      if (kh.আমিষ) {
        html += '<h2>🍗 আমিষ</h2>';
        kh.আমিষ.forEach(item => {
          html += `<div class="item-card"><div class="item-img">${item.ছবি || '🥩'}</div><div class="item-content"><strong>${item.নাম}</strong><ul>${item.বিস্তারিত_কারণ.map(r => `<li>${r}</li>`).join('')}</ul></div></div>`;
        });
      }
      if (kh.ভিটামিন_ও_খনিজ) {
        html += '<h2>🥦 ভিটামিন ও খনিজ</h2>';
        kh.ভিটামিন_ও_খনিজ.forEach(item => {
          html += `<div class="item-card"><div class="item-img">${item.ছবি || '🥬'}</div><div class="item-content"><strong>${item.নাম}</strong><ul>${item.বিস্তারিত_কারণ.map(r => `<li>${r}</li>`).join('')}</ul></div></div>`;
        });
      }
      if (kh.পানি) {
        html += `<h2>💧 পানি</h2><div class="item-card"><div class="item-img">${kh.পানি.ছবি || '💧'}</div><div class="item-content"><strong>পরিমাণ: ${kh.পানি.পরিমাণ}</strong><ul>${kh.পানি.বিস্তারিত_কারণ.map(r => `<li>${r}</li>`).join('')}</ul></div></div>`;
      }
      if (kh.খনিজ_লবণ) {
        html += '<h2>🧂 খনিজ লবণ</h2>';
        kh.খনিজ_লবণ.forEach(item => {
          html += `<div class="item-card"><div class="item-img">${item.ছবি || '🫘'}</div><div class="item-content"><strong>${item.নাম}</strong><ul>${item.বিস্তারিত_কারণ.map(r => `<li>${r}</li>`).join('')}</ul></div></div>`;
        });
      }
    } else { // ব্যায়াম
      page3Title.innerText = '🧘 ব্যায়াম';
      html = '<h2>🧘 প্রতিদিনের ব্যায়াম</h2>';
      data.প্রতিদিনের_ব্যায়াম.forEach(ex => {
        html += `<div class="item-card"><div class="item-img">${ex.ছবি || '🏋️'}</div><div class="item-content"><strong>${ex.ব্যায়ামের_নাম} (${ex.সময় || '১৫-২০ মিনিট'})</strong><ul>${ex.বিস্তারিত_কারণ.map(r => `<li>${r}</li>`).join('')}</ul></div></div>`;
      });
    }

    container.innerHTML = html;
  }

  // পৃষ্ঠা পরিবর্তন ফাংশন
  function goToPage2(trimester) {
    currentTrimester = trimester;
    document.getElementById('page1').classList.remove('active');
    document.getElementById('page2').classList.add('active');
    document.getElementById('page3').classList.remove('active');
    updatePage2();
  }

  function goToPage3(type) {
    currentDetailType = type;
    document.getElementById('page1').classList.remove('active');
    document.getElementById('page2').classList.remove('active');
    document.getElementById('page3').classList.add('active');
    renderDetailPage(type);
  }

  function goToPage1() {
    document.getElementById('page1').classList.add('active');
    document.getElementById('page2').classList.remove('active');
    document.getElementById('page3').classList.remove('active');
  }

  function goToDashboard() {
    
    window.location.href = "#"; // "#" এর জায়গায় আপনার ড্যাশবোর্ড URL 
    alert("Dashboard এ যাওয়া হচ্ছে...");
  }

  // বাটনে ইভেন্ট
  document.getElementById('goFoodBtn').addEventListener('click', ()=> goToPage3('food'));
  document.getElementById('goExerciseBtn').addEventListener('click', ()=> goToPage3('exercise'));
  document.getElementById('backToPage2Btn').addEventListener('click', ()=>{
    document.getElementById('page3').classList.remove('active');
    document.getElementById('page2').classList.add('active');
  });

  window.addEventListener('load', ()=> {
    updatePage2();
  });
</script>

</body>
</html>
