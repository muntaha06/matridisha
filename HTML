<!DOCTYPE html>
<html lang="bn">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>মাতৃদিশা · ত্রৈমাসিক গাইড</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      transition: all 0.2s ease;
    }

    body {
      font-family: 'Segoe UI', 'Roboto', 'Arial', sans-serif;
      background: linear-gradient(145deg, #fae1e9 0%, #fdf0f5 100%);
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      margin: 0;
      padding: 1rem;
    }

    .card {
      background: rgba(255, 255, 255, 0.95);
      backdrop-filter: blur(2px);
      width: 850px;
      max-width: 100%;
      padding: 2.2rem 1.8rem;
      border-radius: 48px;
      box-shadow: 0 25px 40px rgba(160, 100, 120, 0.25);
      text-align: center;
      border: 2px solid #ffe2ed;
    }

    h1 {
      color: #b23b62;
      font-size: 2.6rem;
      margin-bottom: 0.3rem;
      letter-spacing: 1px;
    }

    .tagline {
      background: #fff1f7;
      color: #5f3e49;
      padding: 0.7rem 2rem;
      border-radius: 60px;
      display: inline-block;
      margin-bottom: 2rem;
      font-size: 1.1rem;
      border: 1px solid #fec7db;
    }

    /* ড্যাশবোর্ড বাটন - নিচে রাখা হয়েছে */
    .dashboard-btn {
      background: #edb8cc;
      border: none;
      padding: 0.8rem 2rem;
      border-radius: 40px;
      color: white;
      font-weight: 600;
      cursor: pointer;
      box-shadow: 0 4px 0 #b06784;
      font-size: 1.1rem;
      margin-top: 2rem;
      display: inline-block;
    }
    .dashboard-btn:hover { 
      background: #d68eaa; 
      transform: translateY(-2px); 
      box-shadow: 0 6px 0 #9f5575; 
    }

    /* ট্রাইমেস্টার বাটন (পৃষ্ঠা ১) */
    .grid-3 {
      display: flex;
      gap: 1.2rem;
      justify-content: center;
      margin-bottom: 2.5rem;
      flex-wrap: wrap;
    }

    .trimester-btn {
      background: #fcedf2;
      border: none;
      padding: 1.8rem 0.7rem;
      border-radius: 32px;
      cursor: pointer;
      flex: 1 1 140px;
      min-width: 140px;
      box-shadow: 0 10px 18px #efc9d6;
      font-weight: bold;
      color: #aa385c;
      border: 2px solid #ffdae7;
    }

    .trimester-btn strong {
      font-size: 1.5rem;
      display: block;
      margin-bottom: 0.5rem;
    }

    .trimester-btn small {
      font-size: 0.95rem;
      background: white;
      padding: 0.3rem 1rem;
      border-radius: 40px;
    }

    .trimester-btn:hover {
      background: #dd87a6;
      color: white;
      transform: translateY(-6px);
    }
    .trimester-btn:hover small { background: #fef3f7; color: #a1355b; }

    /* পৃষ্ঠা ২ ও ৩ সাধারণ নেভি */
    .nav-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 1.2rem;
      flex-wrap: wrap;
    }
    .nav-header .back-home {
      background: #edb8cc;
      border: none;
      padding: 0.6rem 1.5rem;
      border-radius: 40px;
      color: white;
      font-weight: 600;
      cursor: pointer;
      box-shadow: 0 4px 0 #b06784;
      font-size: 1rem;
    }
    .nav-header .back-home:hover { background: #d68eaa; transform: translateY(-2px); box-shadow: 0 6px 0 #9f5575; }

    /* ট্রাইমেস্টার ওভারভিউ (পৃষ্ঠা ২) */
    .summary-panel {
      background: #fef2f7;
      border-radius: 56px;
      padding: 1.4rem 1.5rem;
      margin: 1rem 0 1.8rem 0;
      border: 2px solid #ffd2e2;
    }
    .summary-panel .month-title {
      font-size: 2.1rem;
      color: #9e325a;
      font-weight: 700;
    }
    .summary-panel .month-sub {
      background: white;
      padding: 0.3rem 1.8rem;
      border-radius: 40px;
      display: inline-block;
      color: #613d49;
      margin: 0.5rem 0;
    }
    .summary-panel .time-badge {
      background: #ffe7f1;
      padding: 0.5rem;
      border-radius: 30px;
      margin: 0.7rem 0 0.3rem;
    }
    .summary-panel .importance {
      background: #ffe2ed;
      border-radius: 28px;
      padding: 0.7rem 1rem;
      font-size: 1rem;
    }

    /* অ্যাকশন বাটন (খাবার/ব্যায়াম) */
    .action-row {
      display: flex;
      gap: 2rem;
      justify-content: center;
      margin: 2rem 0 1.5rem;
      flex-wrap: wrap;
    }
    .action-btn {
      background: white;
      border: 3px solid #ffcbd9;
      padding: 1rem 3rem;
      border-radius: 70px;
      font-size: 1.8rem;
      font-weight: 700;
      color: #b34069;
      box-shadow: 0 7px 0 #dc9bb3;
      cursor: pointer;
      min-width: 200px;
    }
    .action-btn:hover { transform: translateY(-4px); box-shadow: 0 11px 0 #c57999; }

    /* পৃষ্ঠা ৩ – বিস্তারিত খাবার/ব্যায়াম (ছবি সহ) */
    .detail-scroll {
      max-height: 500px;
      overflow-y: auto;
      padding: 0.8rem 0.3rem 0.8rem 0.8rem;
      margin: 1.2rem 0;
      background: #fdf4f8;
      border-radius: 48px;
      border: 2px solid #ffd5e3;
      text-align: left;
    }
    .detail-scroll h2 {
      color: #ad3862;
      margin: 0 0 1rem 1rem;
      font-size: 2rem;
      border-left: 10px solid #e591b2;
      padding-left: 1rem;
    }
    /* আইটেম কার্ড (ছবি + লেখা) */
    .item-card {
      display: flex;
      background: white;
      border-radius: 38px;
      margin-bottom: 1.5rem;
      padding: 1rem 1.2rem;
      box-shadow: 0 6px 14px #ecc1d1;
      align-items: center;
      gap: 1.2rem;
      border: 1px solid #ffdbe9;
    }
    .item-img {
      width: 90px;
      height: 90px;
      border-radius: 50%;
      background: #f9e3ed;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 2.5rem;
      border: 3px solid #ffb0cb;
      flex-shrink: 0;
      overflow: hidden;
      color: #b34d71;
    }
    .item-content {
      flex: 1;
    }
    .item-content strong {
      font-size: 1.5rem;
      color: #932e55;
      display: block;
      margin-bottom: 0.3rem;
    }
    .item-content ul {
      padding-left: 1.2rem;
      color: #3e2d34;
    }
    .item-content li {
      margin: 0.2rem 0;
    }

    /* পৃষ্ঠা দেখান/লুকান */
    .page { display: none; }
    .page.active { display: block; }
